rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Get user profile from Firestore
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get user role
    function getUserRole() {
      let profile = getUserProfile();
      return profile.get('role', 'viewer');
    }

    // Check if user is admin
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    // Check if user is staff or admin
    function isStaffOrAdmin() {
      let role = getUserRole();
      return isSignedIn() && (role == 'staff' || role == 'admin');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Path Variable Hardening
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validate overall document entity shape and limitations (Pillar 2 & 5)
    function isValidDocument(data) {
      return data.keys().hasAll([
        'id', 'loaiVanBan', 'soBanHanh', 'trichYeu', 'ngayBanHanh', 'ngayCoHieuLuc', 
        'donViBanHanh', 'donViThamMuu', 'soVanBanTrinh', 'ngayTrinh', 
        'linhVuc', 'ownerId', 'createdAt', 'updatedAt'
      ])
      && data.keys().size() <= 18
      && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
      && data.loaiVanBan is string && (data.loaiVanBan == 'Nghị quyết' || data.loaiVanBan == 'Quyết định')
      && data.soBanHanh is string && data.soBanHanh.size() >= 0 && data.soBanHanh.size() <= 200
      && data.trichYeu is string && data.trichYeu.size() >= 1 && data.trichYeu.size() <= 5000
      && data.ngayBanHanh is string && data.ngayBanHanh.size() == 10
      && data.ngayCoHieuLuc is string && data.ngayCoHieuLuc.size() == 10
      && data.donViBanHanh is string && (data.donViBanHanh == 'Hội đồng nhân dân tỉnh' || data.donViBanHanh == 'Ủy ban nhân dân tỉnh')
      && data.donViThamMuu is string && data.donViThamMuu.size() >= 1 && data.donViThamMuu.size() <= 200
      && data.soVanBanTrinh is string && data.soVanBanTrinh.size() >= 0 && data.soVanBanTrinh.size() <= 200
      && data.ngayTrinh is string && (data.ngayTrinh.size() == 0 || data.ngayTrinh.size() == 10)
      && data.linhVuc is string && (data.linhVuc == 'linh_vuc_1' || data.linhVuc == 'linh_vuc_2' || data.linhVuc == 'linh_vuc_3')
      && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
      && (data.get('isQuyTrinhNoiBo', false) is bool)
      && (data.get('ghiChu', '') is string && data.get('ghiChu', '').size() <= 2000)
      && (data.get('fileDinhKem', []) is list);
    }

    // Validate user profile shape (Pillar 6 - Privileged info separation, Role-based access)
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isActive', 'createdAt'])
      && data.keys().size() <= 8
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.email is string && data.email.size() >= 1 && data.email.size() <= 200
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 200
      && data.role is string && (data.role == 'admin' || data.role == 'staff' || data.role == 'viewer')
      && data.isActive is bool
      && (data.get('department', '') is string && data.get('department', '').size() <= 200);
    }

    // Collection: user profiles (Strict PII isolation matching user identity)
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // List/query block is restricted to admins only for user management
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
        
      // Users can update their own profile, admins can update any
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
    }

    // Collection: regulatory documents (Pillar 8 - No query trust, explicit checks)
    match /documents/{documentId} {
      // Allow any visitor to view documents (both single document and listings)
      allow read: if true;

      // Helper to check if user is document owner
      function isDocumentOwner(doc) {
        return isSignedIn() && doc.ownerId == request.auth.uid;
      }

      // Role-based permissions: admin can create, staff and admin can create, viewers cannot
      allow create: if isSignedIn()
        && isValidId(documentId) 
        && isValidDocument(incoming())
        && incoming().id == documentId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().ownerId == request.auth.uid
        && (isAdmin() || isStaffOrAdmin());  // Only admin and staff can create

      // Role-based permissions: admin can update all, staff can update own, viewers cannot
      allow update: if isSignedIn()
        && isValidId(documentId)
        && isValidDocument(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().ownerId == existing().ownerId
        && (isAdmin() || (isStaffOrAdmin() && isDocumentOwner(existing())));

      // Role-based permissions: admin can delete all, staff can delete own, viewers cannot
      allow delete: if isSignedIn()
        && isValidId(documentId)
        && (isAdmin() || (isStaffOrAdmin() && isDocumentOwner(existing())));
    }
  }
}
